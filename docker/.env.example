# Copiar a la raíz del repositorio como .env y rellenar los valores reales

APP_KEY=base64:GENERADO_CON_php_artisan_key:generate
APP_URL=http://TU_DOMINIO_O_IP

DB_DATABASE=lazytripz
DB_USERNAME=lazytripz
DB_PASSWORD=CAMBIA_ESTO
DB_ROOT_PASSWORD=CAMBIA_ESTO_TAMBIEN

GEMINI_API_KEY=TU_GEMINI_API_KEY

OPENWEATHER_API_KEY=TU_OPENWEATHER_KEY
OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5

GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=TU_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://TU_DOMINIO_O_IP:8081/auth/google/callback

# URL desde la que se sirve la SPA (usada en los redirects de OAuth)
FRONTEND_URL=http://TU_DOMINIO_O_IP:8081

# Dominio de las cookies de sesión. Dejar vacío si accedes por IP
SESSION_DOMAIN=
# Poner a false si sirves por HTTP sin certificado
SESSION_SECURE_COOKIE=true

# Laravel corre detrás de nginx: confía en el proxy para obtener la IP real
TRUSTED_PROXIES=*
